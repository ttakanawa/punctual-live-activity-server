  "components": {
    "securitySchemes": {
      "AppAttestKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Attest-Key-Id"
      },
      "AppAttestChallenge": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Attest-Challenge-Id"
      },
      "AppAttestAssertion": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Attest-Assertion"
      }
    },
    "schemas": {
      "ChallengeRequest": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "attestation",
              "assertion"
            ]
          },
          "keyId": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "App Attest key identifier; strict canonical standard Base64 decoding to 32 bytes."
          }
        },
        "required": [
          "purpose",
          "keyId"
        ],
        "additionalProperties": false
      },
      "ChallengeResponse": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "challenge": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "32 cryptographically random bytes, standard padded Base64."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
          }
        },
        "required": [
          "challengeId",
          "challenge",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "AttestationRequest": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attestationObject": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "keyId",
          "challengeId",
          "attestationObject"
        ],
        "additionalProperties": false
      },
      "AttestationResponse": {
        "type": "object",
        "properties": {
          "installationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "authScheme": {
            "type": "string",
            "const": "app-attest-v1"
          }
        },
        "required": [
          "installationId",
          "authScheme"
        ],
        "additionalProperties": false
      },
      "PutEndJob": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$",
            "description": "Positive UInt64 decimal string, <=18446744073709551615; no leading zero. Monotonic per installation/job."
          },
          "pushToken": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4096,
            "pattern": "^(?:[0-9a-f]{2})+$",
            "description": "Variable-length ActivityKit activity push token, lowercase hex. Not a UserNotifications device token."
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
          },
          "notificationAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
          },
          "activityEndsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
          },
          "contentStateVersion": {
            "type": "integer",
            "const": 1
          }
        },
        "required": [
          "revision",
          "pushToken",
          "startsAt",
          "notificationAt",
          "endsAt",
          "activityEndsAt",
          "contentStateVersion"
        ],
        "additionalProperties": false
      },
      "PatchPushToken": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$",
            "description": "Positive UInt64 decimal string, <=18446744073709551615; no leading zero. Monotonic per installation/job."
          },
          "pushToken": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4096,
            "pattern": "^(?:[0-9a-f]{2})+$",
            "description": "Variable-length ActivityKit activity push token, lowercase hex. Not a UserNotifications device token."
          }
        },
        "required": [
          "revision",
          "pushToken"
        ],
        "additionalProperties": false
      },
      "CancelEndJob": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$",
            "description": "Positive UInt64 decimal string, <=18446744073709551615; no leading zero. Monotonic per installation/job."
          }
        },
        "required": [
          "revision"
        ],
        "additionalProperties": false
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_sent",
              "in_flight",
              "accepted",
              "rejected",
              "unknown"
            ]
          },
          "attemptCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "acceptedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
              },
              {
                "type": "null"
              }
            ]
          },
          "mayHaveBeenSent": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "attemptCount",
          "acceptedAt",
          "mayHaveBeenSent"
        ],
        "additionalProperties": false
      },
      "EndJob": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$",
            "description": "Positive UInt64 decimal string, <=18446744073709551615; no leading zero. Monotonic per installation/job."
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "dispatching",
              "retrying",
              "awaiting_token",
              "apns_accepted",
              "cancelled",
              "failed",
              "expired"
            ]
          },
          "activityEndsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "description": "UTC, whole seconds, years 1970 through 9999; real calendar validity is also checked."
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery": {
            "$ref": "#/components/schemas/Delivery"
          },
          "lastError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "jobId",
          "revision",
          "status",
          "activityEndsAt",
          "delivery"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "details": {
                "description": "For STALE_REVISION, REVISION_CONFLICT and DISPATCH_STARTED (HTTP 409), contains currentRevision as the current positive UInt64 decimal string and status as the current EndJob status. The field is currentRevision, not revision.",
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
